#!/usr/bin/python3
import sys

def tonum(s):
    try:
        return int(s)        #floatは前後の改行や空白を無視するのでstrip不要
    except ValueError:
        return float(s)
x = 0
for line in sys.stdin:
    x += tonum(line.rstrip())

print(x)
